# ==============================================================================
# CORTEX AI STUDIO — ENVIRONMENT VARIABLES
# ==============================================================================
# You can provide any or all of these API keys.
# If none are provided, Cortex AI automatically runs in its intelligent Simulator Mode,
# allowing full UI, streaming, agent, and tool development without any paid account!
# ==============================================================================

# Google Gemini API Key (Recommended for fast streaming & multimodal)
GOOGLE_GENERATIVE_AI_API_KEY=""

# OpenAI API Key (Optional)
OPENAI_API_KEY=""

# AI Studio Mode: "live" (requires API key) or "simulator" (works with zero keys)
NEXT_PUBLIC_AI_MODE="simulator"
